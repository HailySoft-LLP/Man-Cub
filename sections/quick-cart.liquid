{%- if section.settings.enable_quick_cart -%}
  {%- liquid
    assign free_gift_parent_product = blank

    for item in cart.items
      unless item.properties['_auto_free_cap'] == 'true' or item.properties['_cart_free_gift'] == 'true'
        assign item_parent_product = item.product
        if item_parent_product != blank
          assign item_man_child = item_parent_product.metafields.custom.man_product.value
          assign item_cub_child = item_parent_product.metafields.custom.kid_product.value
          if item_man_child != blank or item_cub_child != blank
            assign free_gift_parent_product = item_parent_product
          endif
        endif
      endunless
    endfor

    assign free_gift_product = section.settings.auto_free_cap_product
    assign free_gift_cub_product = section.settings.auto_free_cap_cub_product

    if free_gift_parent_product != blank
      assign parent_man_product = free_gift_parent_product.metafields.custom.man_product.value
      assign parent_cub_product = free_gift_parent_product.metafields.custom.kid_product.value

      if parent_man_product != blank
        assign free_gift_product = parent_man_product
      endif

      if parent_cub_product != blank
        assign free_gift_cub_product = parent_cub_product
      endif
    endif

    assign free_gift_variant_id = blank

    if free_gift_product != blank
      assign free_gift_variant_id = free_gift_product.selected_or_first_available_variant.id
    endif
  -%}
  {{ 'family-bundle.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'family-bundle.js' | asset_url }}" defer="defer"></script>
  <script>
    window.theme = window.theme || {};
    window.MCFreeGiftPopupEnabled = {{ section.settings.free_gift_popup_enabled | json }};
    window.theme.autoFreeCap = Object.assign({}, window.theme.autoFreeCap || {}, {
      thresholdCents: {{ section.settings.auto_free_cap_threshold_gbp | default: '150' | plus: 0 | times: 100 }},
      currentCurrency: {{ localization.country.currency.iso_code | json }},
      thresholdsByCurrency: {
        GBP: {{ section.settings.auto_free_cap_threshold_gbp | default: '150' | plus: 0 | times: 100 }},
        USD: {{ section.settings.auto_free_cap_threshold_usd | default: '200' | plus: 0 | times: 100 }},
        EUR: {{ section.settings.auto_free_cap_threshold_eur | default: '175' | plus: 0 | times: 100 }},
        CAD: {{ section.settings.auto_free_cap_threshold_cad | default: '300' | plus: 0 | times: 100 }},
        AED: {{ section.settings.auto_free_cap_threshold_aed | default: '750' | plus: 0 | times: 100 }}
      },
      otherThresholdCents: {{ section.settings.auto_free_cap_threshold_other | default: '150' | plus: 0 | times: 100 }},
      {% if free_gift_product != blank %}
      variantId: {% if free_gift_variant_id != blank %}{{ free_gift_variant_id | json }}{% else %}null{% endif %},
      productHandle: {{ free_gift_product.handle | json }}
      {% endif %}
    });
  </script>
  <div
    class="
      quick-cart
      {% if settings.enable_section_animations %}
        animation
        animation--quick-cart
      {% endif %}
    "
    data-section-id="{{ section.id }}"
    data-section-type="quick-cart"
  >
    <div class="quick-cart__wrapper">
      <div class="quick-cart__overlay"></div>
      <div class="quick-cart__container">
        <div class="quick-cart__header">
          <h2 class="quick-cart__heading ff-heading fs-heading-5-base">
            {{ 'cart.general.cart' | t -}}
            {%- if cart.item_count > 0 -%}
              <sup>{{ cart.item_count }}</sup>
            {%- endif %}
          </h2>
          <button
            type="button"
            data-modal-close
            class="quick-cart__close-icon"
            aria-label="{{ 'general.accessibility.close_modal' | t }}"
          >
            {% render 'icon-button', small: true, icon: 'close' %}
          </button>
        </div>

        {%- if cart.item_count > 0 -%}
          <form
            action="{{ routes.cart_url }}"
            method="post"
            data-form
            novalidate
            data-scroll-lock-ignore
            class="quick-cart__form"
          >
            <div class="quick-cart__items animation--quick-cart-items">
              {%- render 'free-shipping-bar' %}
              {%- render 'cart-free-cap-progress',
                free_cap_threshold_gbp: section.settings.auto_free_cap_threshold_gbp,
                free_cap_threshold_usd: section.settings.auto_free_cap_threshold_usd,
                free_cap_threshold_eur: section.settings.auto_free_cap_threshold_eur,
                free_cap_threshold_cad: section.settings.auto_free_cap_threshold_cad,
                free_cap_threshold_aed: section.settings.auto_free_cap_threshold_aed,
                free_cap_success_message: section.settings.auto_free_cap_success_message,
                free_cap_eligible_message: section.settings.auto_free_cap_eligible_message,
                free_cap_eligible_link_label: section.settings.auto_free_cap_eligible_link_label,
                free_cap_remaining_message: section.settings.auto_free_cap_remaining_message,
                free_cap_show_remaining_message: section.settings.auto_free_cap_show_remaining_message,
                free_cap_popup_enabled: section.settings.free_gift_popup_enabled
              -%}

              {%- assign rendered_bundle_ids_qc = '' -%}
              {%- for item in cart.items -%}
                {%- assign item_bundle_id = item.properties['_bundle_id'] -%}
                {%- assign item_bundle_name = item.properties['Bundle'] -%}
                {%- assign item_is_preorder = false -%}
                {%- if item.properties['_preorder'] == 'true' or item.properties['Pre-order'] != blank -%}
                  {%- assign item_is_preorder = true -%}
                {%- endif -%}
                {%- assign item_is_auto_free_cap = false -%}
                {%- if item.properties['_auto_free_cap'] == 'true' or item.properties['_cart_free_gift'] == 'true' -%}
                  {%- assign item_is_auto_free_cap = true -%}
                {%- endif -%}
                {%- assign item_is_free_cap_display = item_is_auto_free_cap -%}
                {%- if item.product.handle == 'cap-man-size' and item.final_line_price == 0 -%}
                  {%- assign item_is_free_cap_display = true -%}
                {%- endif -%}

                {%- if item_bundle_id != blank -%}
                  {%- if rendered_bundle_ids_qc contains item_bundle_id -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- assign rendered_bundle_ids_qc = rendered_bundle_ids_qc | append: item_bundle_id | append: '|' -%}

                  {%- render 'cart-bundle-group',
                    cart: cart,
                    item_bundle_id: item_bundle_id,
                    item_bundle_name: item_bundle_name,
                    prefix: 'quick-cart',
                    show_currency: section.settings.show_product_currency,
                    currency_code: cart.currency.iso_code
                  -%}

                {%- else -%}
                  <div class="quick-cart__item" data-input-item data-id="{{ item.id }}" data-key="{{ item.key }}">
                    <div class="quick-cart__item-image">
                      <a href="{{ item.url }}" class="quick-cart__item-link">
                        {%- render 'image',
                          image: item.image,
                          sizes: '120px',
                          prioritize_loading: true,
                          aspect_ratio: settings.cart_item_aspect_ratio,
                          include_placeholder: true
                        -%}
                      </a>
                    </div>
                    <div class="quick-cart__item-details">
                      <div class="quick-cart__item-top">
                        <h4 class="quick-cart__item-title fs-product-card-title">
                          <a href="{{ item.url }}">{{ item.product.title }}</a>
                        </h4>
                        {%- if item_is_preorder -%}
                          <span class="mc-preorder-badge quick-cart__preorder-badge fs-body-50">Pre-order</span>
                        {%- endif -%}
                        {% unless item.product.has_only_default_variant %}
                          <p class="quick-cart__item-variant fs-body-60 t-opacity-60">{{ item.variant.title }}</p>
                        {% endunless %}
                        {% if item.selling_plan_allocation %}
                          <p class="quick-cart__item-subscriptions fs-body-60 t-opacity-60">
                            {{ item.selling_plan_allocation.selling_plan.name }}
                          </p>
                        {% endif %}
                        {%- assign property_size = item.properties | size -%}
                        {% if property_size > 0 %}
                          <div class="quick-cart__form-item-properties fs-body-60 t-opacity-80">
                            {% for p in item.properties %}
                              {% assign first_char = p.first | slice: 0 %}
                              {% unless p.last == blank or first_char == '_' or p.first == 'Pre-order' %}
                                <p>{{ p.first }}: {{ p.last }}</p>
                              {% endunless %}
                            {% endfor %}
                          </div>
                          <script type="application/json" data-item-properties>{{ item.properties | json }}</script>
                        {% endif %}
                        {% liquid
                          assign price_content_type = 'price'
                          if item.original_price == 0 and settings.zero_dollar_cart_price_display == 'replace'
                            assign price_content_type = 'custom'
                          endif
                          assign item_price = item.original_price
                          assign item_sale_price = blank
                          assign price_tag_type = 'span'
                          if item_is_free_cap_display
                            assign item_price = 0
                          elsif item.original_line_price > item.final_line_price or item.variant.compare_at_price > item.variant.price
                            assign price_tag_type = 's'
                            if item.original_line_price > item.final_line_price
                              assign item_sale_price = item.final_price
                            else
                              assign item_price = item.variant.compare_at_price
                              assign item_sale_price = item.original_price
                            endif
                          endif
                          if section.settings.show_product_currency
                            capture iso_code
                              echo cart.currency.iso_code
                            endcapture
                          endif
                        %}
                        {% if price_content_type == 'price' or item.variant.compare_at_price > item.original_price %}
                          <div class="quick-cart__item-price-wrapper fs-body-75">
                            <{{ price_tag_type }} class="quick-cart__item-price">
                              {{- item_price | money }} {{ iso_code -}}
                            </{{ price_tag_type }}>
                            {%- if item_sale_price != blank -%}
                              <span class="quick-cart__item-price sale-price">
                                {{- item_sale_price | money }} {{ iso_code -}}
                              </span>
                            {%- endif -%}
                            {% render 'unit-price', item: item %}
                          </div>
                        {% elsif price_content_type == 'custom' %}
                          <div class="quick-cart__item-price-wrapper fs-body-75">
                            <span class="quick-cart__item-price">{{ 'products.inventory.zero_price_custom_label' | t }}</span>
                          </div>
                        {% endif %}
                        {% if item.line_level_discount_allocations.size > 0 and item_is_free_cap_display == false %}
                          <ul class="quick-cart__item-discounts">
                            {% for discount_allocation in item.line_level_discount_allocations %}
                              <li class="quick-cart__item-discount fs-body-60">
                                {%- render 'icon', icon: 'discount-badge' -%}
                                {{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </div>
                      <div class="quick-cart__item-bottom">
                        <p class="quick-cart__item-error fs-body-50 hidden">{{ 'cart.general.error' | t }}</p>
                        {%- if settings.enable_low_inventory_warning -%}
                          {%- liquid
                            assign item_variants = item.product.variants
                            assign item_variant = item_variants | where: 'id', item.variant_id | first
                          -%}
                          {%- if item_variant.inventory_management != blank
                            and item_variant.inventory_policy == 'deny'
                            and item_variant.inventory_quantity < settings.low_inventory_warning_threshold
                          -%}
                            <p class="quick-cart__inventory-warning fs-body-50">
                              {{ 'cart.general.inventory_warning' | t: amount: item_variant.inventory_quantity }}
                            </p>
                          {%- endif -%}
                        {%- endif -%}
                        {% render 'quantity-input', id: item.id, initial_value: item.quantity, update_key: item.key %}
                        <button type="button" data-remove-item class="quick-cart__item-remove fs-body-75 t-subdued btn btn--text-link">
                          {{ 'cart.general.remove' | t }}
                        </button>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
              {%- render 'orphan-upsell-cart', cart: cart -%}
              {%- if settings.enable_cross_sells -%}
                {%- render 'cross-sells', cart: cart, display: settings.quick_cart_cross_sells_display -%}
              {%- endif -%}
            </div>
            <div class="quick-cart__footer animation--quick-cart-footer">
              <div class="quick-cart__footer-inner">
                {%- if settings.show_cart_notes -%}
                  <div class="quick-cart__footer-order-note-wrapper" aria-expanded="false" aria-hidden="true">
                    <button
                      type="button"
                      class="quick-cart__footer-order-note-trigger fs-body-75 btn btn--text-link"
                      data-order-note-trigger
                    >
                      <div class="quick-cart__footer-order-note-trigger-icons">
                        {% render 'icon', icon: 'plus-small' %}
                        {% render 'icon', icon: 'minus-small', class: 'hidden' %}
                      </div>
                      <span class="quick-cart__footer-order-note-trigger-text" data-cart-not-trigger-text>
                        {{ 'cart.general.order_note_button_add' | t }}
                      </span>
                    </button>
                    <div class="quick-cart__footer-order-note-input" cart-note-input>
                      <label for="CartSpecialInstructions" class="fs-body-100">
                        {{- 'cart.general.order_note_label' | t -}}
                      </label>
                      <textarea
                        name="note"
                        id="CartSpecialInstructions"
                        class="input"
                        placeholder="{{ 'cart.general.order_note_placeholder' | t }}"
                      >{{ cart.note }}</textarea>
                    </div>
                  </div>
                {%- endif -%}

                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  <ul class="quick-cart__item-discounts">
                    {% for discount_application in cart.cart_level_discount_applications %}
                      <li class="quick-cart__item-discount fs-body-60">
                        {%- render 'icon', icon: 'discount-badge' -%}
                        {{ discount_application.title }} (-{{ discount_application.total_allocated_amount | money }})
                      </li>
                    {% endfor %}
                  </ul>
                {%- endif -%}

                <div class="quick-cart__footer-subtotal">
                  <h3 class="ff-body fs-body-200">{{ 'cart.general.subtotal' | t }}</h3>
                  <span class="ff-body fs-body-200">
                    {{- cart.total_price | money -}}
                    {%- if section.settings.show_product_currency %} {{ cart.currency.iso_code }}{% endif -%}
                  </span>
                </div>
                <p class="quick-cart__footer-tax-note ff-body fs-body-75 t-subdued">
                  {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                    {{ 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- elsif cart.taxes_included -%}
                    {{ 'cart.general.taxes_included_but_shipping_at_checkout' | t }}
                  {%- elsif shop.shipping_policy.body != blank -%}
                    {{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
                  {%- else -%}
                    {{ 'cart.general.taxes_and_shipping_at_checkout' | t }}
                  {%- endif -%}
                </p>

                <button
                  type="submit"
                  name="checkout"
                  class="quick-cart__submit btn btn--full btn--primary"
                  aria-label="{{ 'cart.general.checkout' | t }}"
                >
                  {{ 'cart.general.checkout' | t }}
                </button>
              </div>
            </div>
          </form>
        {%- else -%}
          <div class="quick-cart__empty-state">
            <h3 class="quick-cart__empty-state-heading ff-heading fs-heading fs-heading-4-base">
              {{ 'cart.general.empty' | t }}
            </h3>
            {%- render 'cart-free-cap-progress',
              free_cap_threshold_gbp: section.settings.auto_free_cap_threshold_gbp,
              free_cap_threshold_usd: section.settings.auto_free_cap_threshold_usd,
              free_cap_threshold_eur: section.settings.auto_free_cap_threshold_eur,
              free_cap_threshold_cad: section.settings.auto_free_cap_threshold_cad,
              free_cap_threshold_aed: section.settings.auto_free_cap_threshold_aed,
              free_cap_success_message: section.settings.auto_free_cap_success_message,
              free_cap_eligible_message: section.settings.auto_free_cap_eligible_message,
              free_cap_eligible_link_label: section.settings.auto_free_cap_eligible_link_label,
              free_cap_remaining_message: section.settings.auto_free_cap_remaining_message,
              free_cap_show_remaining_message: section.settings.auto_free_cap_show_remaining_message,
              free_cap_popup_enabled: section.settings.free_gift_popup_enabled
            -%}
            {%- if settings.collection_list != blank -%}
              {%- if settings.promotion_text != blank -%}
                <div class="quick-cart__empty-state-promot-text rte ff-body fs-body-100">
                  {{ settings.promotion_text }}
                </div>
              {%- endif -%}

              {%- for collection in settings.collection_list -%}
                {%- render 'button-block',
                  wrapper_class: 'quick-cart__empty-state-promo-button',
                  link: collection.url,
                  label: collection.title,
                  button_style: settings.collection_list_button_style,
                  button_alignment: 'center'
                -%}
              {%- endfor -%}
            {%- else -%}
              {%- assign empty_label = 'cart.general.continue_shopping' | t -%}

              {%- render 'button-block',
                wrapper_class: 'quick-cart__empty-state-promo-button',
                link: settings.continue_shopping_link,
                label: empty_label,
                button_style: settings.collection_list_button_style,
                button_alignment: 'center'
              -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- render 'free-gift-popup',
    free_gift_product: free_gift_product,
    free_gift_cub_product: free_gift_cub_product,
    free_gift_popup_enabled: section.settings.free_gift_popup_enabled,
    free_gift_popup_heading: section.settings.free_gift_popup_heading,
    free_gift_popup_subtext: section.settings.free_gift_popup_subtext,
    free_gift_popup_button: section.settings.free_gift_popup_button,
    free_gift_popup_man_label: section.settings.free_gift_popup_man_label,
    free_gift_popup_cub_label: section.settings.free_gift_popup_cub_label,
    free_gift_popup_man_sizes: section.settings.free_gift_popup_man_sizes,
    free_gift_popup_cub_sizes: section.settings.free_gift_popup_cub_sizes
  -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.quick_cart.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_quick_cart",
      "label": "t:sections.quick_cart.settings.enable_quick_cart.label",
      "info": "t:sections.quick_cart.settings.enable_quick_cart.info",
      "default": true
    },
    {
      "type": "header",
      "content": "Auto free cap"
    },
    {
      "type": "product",
      "id": "auto_free_cap_product",
      "label": "Free gift man product"
    },
    {
      "type": "product",
      "id": "auto_free_cap_cub_product",
      "label": "Free gift cub product",
      "info": "Optional. If left blank, the popup uses the man gift product and saves Cub as a cart property."
    },
    {
      "type": "text",
      "id": "auto_free_cap_threshold_gbp",
      "label": "GBP threshold",
      "default": "150"
    },
    {
      "type": "text",
      "id": "auto_free_cap_threshold_usd",
      "label": "USD threshold",
      "default": "200"
    },
    {
      "type": "text",
      "id": "auto_free_cap_threshold_eur",
      "label": "EUR threshold",
      "default": "175"
    },
    {
      "type": "text",
      "id": "auto_free_cap_threshold_cad",
      "label": "CAD threshold",
      "default": "300"
    },
    {
      "type": "text",
      "id": "auto_free_cap_threshold_aed",
      "label": "AED threshold",
      "default": "750"
    },
    {
      "type": "text",
      "id": "auto_free_cap_threshold_other",
      "label": "Other currency threshold",
      "default": "150"
    },
    {
      "type": "text",
      "id": "auto_free_cap_success_message",
      "label": "Free gift added message",
      "default": "Your free cap has been added to your cart"
    },
    {
      "type": "text",
      "id": "auto_free_cap_eligible_message",
      "label": "Eligible message",
      "default": "You are eligible to claim free gift"
    },
    {
      "type": "text",
      "id": "auto_free_cap_eligible_link_label",
      "label": "Eligible message link label",
      "default": "Click here."
    },
    {
      "type": "text",
      "id": "auto_free_cap_remaining_message",
      "label": "Remaining amount message",
      "info": "Use [amount] as placeholder. Example: [amount] away from your gift.",
      "default": "[amount] away from free gift"
    },
    {
      "type": "checkbox",
      "id": "auto_free_cap_show_remaining_message",
      "label": "Show remaining amount message",
      "default": true
    },
    {
      "type": "header",
      "content": "Free gift popup"
    },
    {
      "type": "checkbox",
      "id": "free_gift_popup_enabled",
      "label": "Show popup (let customer choose size)",
      "info": "When OFF, the gift product is added automatically without a popup",
      "default": true
    },
    {
      "type": "text",
      "id": "free_gift_popup_heading",
      "label": "Popup heading",
      "default": "You've unlocked a free gift!"
    },
    {
      "type": "text",
      "id": "free_gift_popup_subtext",
      "label": "Popup subtext",
      "default": "Choose your size below and claim your free cap."
    },
    {
      "type": "text",
      "id": "free_gift_popup_button",
      "label": "Popup button label",
      "default": "Claim Free Gift"
    },
    {
      "type": "text",
      "id": "free_gift_popup_man_label",
      "label": "Man option label",
      "default": "MAN"
    },
    {
      "type": "text",
      "id": "free_gift_popup_cub_label",
      "label": "Cub option label",
      "default": "CUB"
    },
    {
      "type": "text",
      "id": "free_gift_popup_man_sizes",
      "label": "Man sizes",
      "info": "Comma-separated fallback sizes used when the gift product has no size variants.",
      "default": "Small, Medium, Large, XL, 2XL"
    },
    {
      "type": "text",
      "id": "free_gift_popup_cub_sizes",
      "label": "Cub sizes",
      "info": "Comma-separated fallback sizes used when the gift product has no size variants.",
      "default": "1 years, 2 years, 3 years, 4 years, 5 years, 7 years"
    },
    {
      "type": "header",
      "content": "t:sections.shared.cart.settings.product_items.header.content"
    },
    {
      "type": "checkbox",
      "id": "show_product_currency",
      "label": "t:sections.shared.cart.settings.product_items.show_product_currency.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.shared.cart.settings.empty_cart_promotion.header.content"
    },
    {
      "type": "url",
      "id": "continue_shopping_link",
      "label": "t:sections.shared.cart.settings.empty_cart_promotion.continue_shopping_link.label",
      "default": "/collections"
    },
    {
      "type": "text",
      "id": "promotion_text",
      "label": "t:sections.shared.cart.settings.empty_cart_promotion.promotion_text.label",
      "default": "/collections",
      "info": "t:sections.shared.cart.settings.empty_cart_promotion.promotion_text.info"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:sections.shared.cart.settings.empty_cart_promotion.collection_list.label"
    },
    {
      "type": "select",
      "id": "collection_list_button_style",
      "label": "t:sections.shared.cart.settings.empty_cart_promotion.collection_list_button_style.label",
      "options": [
        {
          "value": "btn--primary",
          "label": "t:sections.shared.cart.settings.empty_cart_promotion.collection_list_button_style.options.solid"
