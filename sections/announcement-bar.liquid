<script>
  {% # This is done here AND in the JS so it's responsive in the theme editor before the JS is loaded %}
  document.documentElement.setAttribute("data-enable-sticky-announcement-bar", "{{ section.settings.enable_sticky_announcement_bar }}");
</script>

{%- if section.blocks.size -%}
  {%- capture items -%}
    {%- for block in section.blocks -%}
      {%- assign base_cents = settings.free_shipping_threshold | times: 100 -%}
      {%- assign amount_span = '<span class="js-announcement-amount" data-base-cents="' | append: base_cents | append: '"></span>' -%}
      <div
        class="announcement-bar__item ff-body fs-body-50 swiper-slide"
        {% unless forloop.first %}
          inert
        {% endunless %}
        data-slide
        {{ block.shopify_attributes }}
        data-index="{{ forloop.index0 }}"
      >
        {%- assign has_mobile_text = false -%}
        {%- if block.settings.title_mobile != blank and block.settings.title_mobile != block.settings.title -%}
          {%- assign has_mobile_text = true -%}
          {%- assign title_mobile = block.settings.title_mobile | replace: '|amount|', amount_span -%}

          <div class="announcement-bar__item-inner announcement-bar__item-inner-mobile-only">
            {%- if block.settings.link != blank -%}
              <a class="announcement-bar__link color-inherit" href="{{ block.settings.link }}">
                {{ title_mobile | replace: '<a ', '<span class="fake-link" ' | replace: '</a>', '</span>' }}
              </a>
            {%- else -%}
              {{ title_mobile }}
            {%- endif -%}
          </div>
        {%- endif -%}
        <div class="announcement-bar__item-inner{% if has_mobile_text %} announcement-bar__item-inner-desktop-only{% endif %}">
          {%- if block.settings.link != blank -%}
            <a class="announcement-bar__link color-inherit" href="{{ block.settings.link }}">
              {{ block.settings.title | replace: '<a ', '<span class="fake-link" ' | replace: '</a>', '</span>' }}
            </a>
          {%- else -%}
            {{ block.settings.title | replace: '|amount|', amount_span }}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  {%- endcapture -%}
  <div
    {% if section.blocks.size == 0 %}
      hidden
    {% endif %}
    class="announcement-bar{% if section.blocks.size == 0 %} hidden{% endif %}"
    data-section-id="{{ section.id }}"
    data-section-type="announcement-bar"
    data-enable-sticky-announcement-bar="{{ section.settings.enable_sticky_announcement_bar }}"
    data-item-count="{{ section.blocks.size }}"
    style="
      --color-background: {{ section.settings.color_background }};
      --color-gradient-overlay: {{ section.settings.color_background | color_modify: 'alpha', 1 }};
      --color-gradient-overlay-transparent: {{ section.settings.color_background | color_modify: 'alpha', 0 }};
      --color-text: {{ section.settings.color_text }};
    "
  >
    <div class="ui-overlap-wrap">
      <div class="ui-overlap">
        <div class="fader left">
          <button class="slider-nav-button slider-nav-button-prev" title="{{ 'general.accessibility.previous' | t }}">
            {% render 'icon', icon: 'chevron' %}
          </button>
        </div>
        <div class="ui-overlap-item-clones" aria-hidden="true">
          {{ items }}
        </div>
        <div class="fader right">
          <button class="slider-nav-button slider-nav-button-next" title="{{ 'general.accessibility.next' | t }}">
            {% render 'icon', icon: 'chevron' %}
          </button>
        </div>
      </div>
    </div>
    <div
      class="swiper"
      data-slider
      data-autoplay-enabled="{{ section.settings.autoplay_enabled }}"
      data-autoplay-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
    >
      <div class="swiper-wrapper">
        {{ items }}
      </div>
    </div>
  </div>
{%- endif -%}

<script>
  (function() {
    // Format cents using the active currency's money format from window.theme.moneyFormat
    function announcementFormatMoney(cents) {
      var format = (window.theme && window.theme.moneyFormat) ? window.theme.moneyFormat : '{{amount}}';
      if (typeof cents === 'string') cents = cents.replace('.', '');
      var value = '';
      var placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
      function formatWithDelimiters(number, precision, thousands, decimal) {
        precision = precision !== undefined ? precision : 2;
        thousands = thousands !== undefined ? thousands : ',';
        decimal = decimal !== undefined ? decimal : '.';
        if (isNaN(number) || number == null) return 0;
        number = (number / 100.0).toFixed(precision);
        var parts = number.split('.');
        var dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
        return dollars + (parts[1] ? decimal + parts[1] : '');
      }
      var match = format.match(placeholderRegex);
      if (!match) return cents;
      switch (match[1]) {
        case 'amount':                              value = formatWithDelimiters(cents, 2); break;
        case 'amount_no_decimals':                  value = formatWithDelimiters(cents, 0); break;
        case 'amount_with_comma_separator':         value = formatWithDelimiters(cents, 2, '.', ','); break;
        case 'amount_no_decimals_with_comma_separator': value = formatWithDelimiters(cents, 0, '.', ','); break;
        case 'amount_with_apostrophe_separator':    value = formatWithDelimiters(cents, 2, "'", '.'); break;
        case 'amount_no_decimals_with_space_separator': value = formatWithDelimiters(cents, 0, ' ', ','); break;
        case 'amount_with_space_separator':         value = formatWithDelimiters(cents, 2, ' ', ','); break;
        case 'amount_with_period_and_space_separator': value = formatWithDelimiters(cents, 2, ' ', '.'); break;
        default:                                    value = formatWithDelimiters(cents, 2); break;
      }
      return format.replace(placeholderRegex, value);
    }

    function updateAnnouncementBarAmount() {
      // Use theme helper when available; fallback to Shopify currency rate
      var rate = 1;
      if (window.theme && typeof window.theme.getDisplayedCurrencyRate === 'function') {
        rate = parseFloat(window.theme.getDisplayedCurrencyRate()) || 1;
      } else if (window.Shopify && window.Shopify.currency && window.Shopify.currency.rate) {
        rate = parseFloat(window.Shopify.currency.rate);
      }
      document.querySelectorAll('.js-announcement-amount').forEach(function(span) {
        var baseCents = parseInt(span.getAttribute('data-base-cents'), 10);
        var converted = Math.round(baseCents * rate);
        span.textContent = announcementFormatMoney(converted);
      });
    }

    document.addEventListener('DOMContentLoaded', updateAnnouncementBarAmount);
  })();
</script>

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "announcement-bar__outer-wrapper",
  "max_blocks": 3,
  "settings": [
    {
      "id": "enable_sticky_announcement_bar",
      "type": "select",
      "label": "t:sections.announcement_bar.settings.enable_sticky_announcement_bar.label",
      "info": "t:sections.announcement_bar.settings.enable_sticky_announcement_bar.info",
      "options": [
        {
          "value": "never",
          "label": "t:sections.announcement_bar.settings.enable_sticky_announcement_bar.options.never"
        },
        {
          "value": "desktop",
          "label": "t:sections.announcement_bar.settings.enable_sticky_announcement_bar.options.desktop"
        },
        {
          "value": "mobile",
          "label": "t:sections.announcement_bar.settings.enable_sticky_announcement_bar.options.mobile"
        },
        {
          "value": "desktop-and-mobile",
          "label": "t:sections.announcement_bar.settings.enable_sticky_announcement_bar.options.both"
        }
      ],
      "default": "never"
    },
    {
      "id": "autoplay_enabled",
      "type": "checkbox",
      "label": "t:sections.announcement_bar.settings.autoplay_enabled.label",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "t:sections.announcement_bar.settings.timing.label",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 4,
      "unit": "s"
    },
    {
      "id": "color_background",
      "type": "color",
      "label": "t:sections.announcement_bar.settings.color_background.label",
      "default": "#000000"
    },
    {
      "id": "color_text",
      "type": "color",
      "label": "t:sections.announcement_bar.settings.color_text.label",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement_bar.blocks.announcement.name",
      "settings": [
        {
          "type": "richtext",
          "id": "title",
          "default": "<p>Free standard shipping and returns on all orders</p>",
          "label": "t:sections.announcement_bar.blocks.announcement.settings.title.label"
        },
        {
          "type": "richtext",
          "id": "title_mobile",
          "label": "t:sections.announcement_bar.blocks.announcement.settings.title_mobile.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement_bar.blocks.announcement.settings.link.label",
          "info": "t:sections.announcement_bar.blocks.announcement.settings.link.info"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement"
      }
    ]
  }
}
{% endschema %}
