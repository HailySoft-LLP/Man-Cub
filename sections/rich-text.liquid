            },
            {
              "value": "external",
              "label": "t:shared.settings.video_source.options.external"
            }
          ],
          "default": "external"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:shared.settings.video.label",
          "info": "t:shared.settings.video.info"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "t:shared.settings.external_video_url.label",
          "accept": [
            "youtube",
            "vimeo"
          ],
          "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc"
        },
        {
          "type": "header",
          "content": "t:shared.section_blocks.play_button.settings.play_button.header.content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:shared.section_blocks.play_button.settings.play_button.image.label",
          "info": "t:shared.section_blocks.play_button.settings.play_button.image.info"
        },
        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "t:shared.section_blocks.play_button.settings.play_button.aspect_ratio.label",
