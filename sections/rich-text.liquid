        },
        {
          "type": "text",
          "id": "text",
          "label": "t:shared.section_blocks.play_button.settings.play_button.text.label",
          "default": "t:shared.section_blocks.play_button.settings.play_button.text.default"
        },
        {
          "type": "select",
          "id": "icon_style",
          "label": "t:shared.section_blocks.play_button.settings.play_button.icon_style.label",
          "options": [
            {
              "value": "dark",
              "label": "t:shared.section_blocks.play_button.settings.play_button.icon_style.options.dark"
            },
            {
              "value": "light",
              "label": "t:shared.section_blocks.play_button.settings.play_button.icon_style.options.light"
            },
            {
              "value": "outline",
              "label": "t:shared.section_blocks.play_button.settings.play_button.icon_style.options.outline"
            }
          ],
          "default": "outline"
        }
      ]
    },
    {
      "type": "border",
      "name": "t:shared.section_blocks.border.name"
    },
    {
      "type": "spacer",
      "name": "t:shared.section_blocks.spacer.name",
      "settings": [
        {
          "type": "range",
          "id": "space",
          "label": "t:shared.section_blocks.spacer.settings.space.label",
          "min": 4,
