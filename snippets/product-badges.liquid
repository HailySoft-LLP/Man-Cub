{% comment %}
  pass in :

  * prod (product - avoid collision with global product)
  * show_sale_badge
  * show_custom_badges
  * show_sold_out_badge - if true, other badges will not be shown
{% endcomment %}

{%- assign badges = '' -%}
{%- assign product_tags = prod.tags -%}
{%- assign badge_tags_1 = settings.custom_product_badge_group_1_tag_names | split: ', ' -%}
{%- assign badge_tags_2 = settings.custom_product_badge_group_2_tag_names | split: ', ' -%}
{%- assign badge_tags_3 = settings.custom_product_badge_group_3_tag_names | split: ', ' -%}
{%- assign badge_tags_4 = settings.custom_product_badge_group_4_tag_names | split: ', ' -%}
{%- assign badge_tags = badge_tags_1 | concat: badge_tags_2 | concat: badge_tags_3 | concat: badge_tags_4 -%}

{%- assign custom_badges_translations = shop.metaobjects.custom_badges.custom_badges_translations -%}
{%- assign sale_badge_enabled = show_sale_badge -%}
{%- assign product_has_sale_badge = false -%}
{%- assign product_sale_badge_text = '' -%}
{%- assign has_preorder_variant = false -%}
{%- assign product_preorder_enabled_value = prod.metafields.custom.preorder_enabled.value -%}
{%- assign product_preorder_enabled_string = product_preorder_enabled_value | append: '' | downcase -%}

{%- if product_preorder_enabled_value == true or product_preorder_enabled_string == 'true' or product_preorder_enabled_string == 'yes' -%}
  {%- assign has_preorder_variant = true -%}
{%- else -%}
  {%- for variant in prod.variants -%}
    {%- assign preorder_enabled_value = variant.metafields.custom.preorder_enabled.value -%}
    {%- assign preorder_enabled_string = preorder_enabled_value | append: '' | downcase -%}
    {%- if preorder_enabled_value == true or preorder_enabled_string == 'true' or preorder_enabled_string == 'yes' -%}
      {%- assign has_preorder_variant = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if show_sale_badge == nil -%}
  {%- assign sale_badge_enabled = true -%}
{%- endif -%}

{%- if prod.compare_at_price > prod.price -%}
  {%- assign product_has_sale_badge = true -%}
{%- else -%}
  {%- for variant in prod.variants -%}
    {%- if variant.compare_at_price > variant.price -%}
      {%- assign product_has_sale_badge = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if product_has_sale_badge == false and prod.price == 0 -%}
  {%- liquid
    assign bundle_total_price = 0
    assign bundle_total_compare_price = 0
    assign bundle_compare_price_available = false
    assign kid_ref = prod.metafields.custom.kid_product.value
    assign man_ref = prod.metafields.custom.man_product.value
    assign woman_ref = prod.metafields.custom.women_product.value

    if kid_ref != blank
      assign bundle_total_price = bundle_total_price | plus: kid_ref.price
      if kid_ref.compare_at_price > kid_ref.price
        assign bundle_total_compare_price = bundle_total_compare_price | plus: kid_ref.compare_at_price
        assign bundle_compare_price_available = true
      else
        assign bundle_total_compare_price = bundle_total_compare_price | plus: kid_ref.price
      endif
    endif

    if man_ref != blank
      assign bundle_total_price = bundle_total_price | plus: man_ref.price
      if man_ref.compare_at_price > man_ref.price
        assign bundle_total_compare_price = bundle_total_compare_price | plus: man_ref.compare_at_price
        assign bundle_compare_price_available = true
      else
        assign bundle_total_compare_price = bundle_total_compare_price | plus: man_ref.price
      endif
    endif

    if woman_ref != blank
      assign bundle_total_price = bundle_total_price | plus: woman_ref.price
      if woman_ref.compare_at_price > woman_ref.price
        assign bundle_total_compare_price = bundle_total_compare_price | plus: woman_ref.compare_at_price
        assign bundle_compare_price_available = true
      else
        assign bundle_total_compare_price = bundle_total_compare_price | plus: woman_ref.price
      endif
    endif

    if bundle_compare_price_available and bundle_total_compare_price > bundle_total_price
      assign product_has_sale_badge = true
    endif
  -%}
{%- endif -%}

{%- if product_has_sale_badge -%}
  {%- capture product_sale_badge_text -%}
    {%- render 'get-display-discount', prod: prod, format: settings.sale_badge_format -%}
  {%- endcapture -%}
  {%- assign product_sale_badge_text = product_sale_badge_text | strip -%}

  {%- if product_sale_badge_text == blank -%}
    {%- assign product_sale_badge_text = 'products.product.on_sale' | t -%}
  {%- endif -%}
{%- endif -%}

{%- unless show_sold_out_badge and prod.available != true %}
  {%- if has_preorder_variant and 1 == 2 -%}
    {%- capture badges -%}
      {{ badges }}
      <div class="product-badge product-badge--preorder">
        NEW IN
      </div>
    {%- endcapture -%}
  {%- endif -%}

  {%- if sale_badge_enabled and product_has_sale_badge -%}
    {%- capture badges -%}
      {{ badges }}
      <div class="product-badge product-badge--sale">
        {{ product_sale_badge_text }}
      </div>
    {%- endcapture -%}
  {%- endif -%}

  {%- if show_custom_badges -%}
    {%- for badge_tag in badge_tags -%}
      {%- for product_tag in product_tags -%}
        {%- assign product_tag_lower = product_tag | downcase -%}
        {%- assign badge_tag_lower = badge_tag | downcase -%}

        {%- if product_tag_lower == badge_tag_lower -%}
          {%- capture badges -%}
            {{ badges }}
            <div class="product-badge" data-handle="{{ badge_tag_lower | handleize }}">
              {%- assign metakey = badge_tag_lower | replace: ' ', '_' -%}
              {%- assign badge_text = custom_badges_translations[metakey] | default: badge_tag -%}
              {{ badge_text }}
            </div>
          {%- endcapture -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endif -%}
{% endunless %}

{%- if show_sold_out_badge -%}
  {%- unless prod.available or placeholder -%}
    {%- capture badges -%}
      {%- comment -%}this replaces all previous {%- endcomment -%}
      <div class="product-badge product-badge--sold-out">
        {{ 'products.product.sold_out' | t }}
      </div>
    {%- endcapture -%}
  {%- endunless -%}
{%- endif -%}

<div
  class="
    product-badges
    product-badges--position-{{ settings.product_listing_badge_position | split: '_' | first }}
    product-badges--position-{{ settings.product_listing_badge_position | split: '_' | last }}
  "
>
  {{ badges }}
</div>
